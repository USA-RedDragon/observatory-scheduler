<ResourceDictionary
    x:Class="NINA.Plugin.TargetScheduler.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ai="clr-namespace:NINA.Plugin.TargetScheduler.Controls.AcquiredImages"
    xmlns:dm="clr-namespace:NINA.Plugin.TargetScheduler.Controls.DatabaseManager"
    xmlns:pp="clr-namespace:NINA.Plugin.TargetScheduler.Controls.PlanPreview"
    xmlns:rp="clr-namespace:NINA.Plugin.TargetScheduler.Controls.Reporting">

    <DataTemplate x:Key="Observatory Scheduler_Options">
        <StackPanel DataContext="{Binding}" Orientation="Vertical">

            <Expander
                Margin="0,10,0,0"
                DataContext="{Binding RemoteOptions}"
                ExpandDirection="Down">
                <Expander.Header>
                    <TextBlock
                        FontSize="14"
                        FontWeight="Bold"
                        Text="Web control"
                        ToolTip="The observatory-scheduler API and web editing" />
                </Expander.Header>
                <StackPanel Margin="10,5,0,0" Orientation="Vertical">
                    <TextBlock Margin="0,0,0,8" Text="{Binding Summary}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left" />
                    <CheckBox Margin="0,0,0,6" Content="Enable the API" IsChecked="{Binding ApiEnabled}" IsEnabled="{Binding Available}" />
                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                        <TextBlock Width="80" VerticalAlignment="Center" Text="Port" />
                        <TextBox Width="80" Text="{Binding ApiPort, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Available}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                        <TextBlock Width="80" VerticalAlignment="Center" Text="Token" />
                        <TextBox Width="360" IsReadOnly="True" Text="{Binding ApiToken, Mode=OneWay}" />
                        <Button Margin="6,0,0,0" Padding="8,0" Command="{Binding CopyTokenCommand}" Content="Copy" />
                        <Button Margin="6,0,0,0" Padding="8,0" Command="{Binding NewTokenCommand}" Content="New token" />
                    </StackPanel>
                    <CheckBox Margin="0,0,0,6" Content="Web editing (makes Target Management here read-only)" IsChecked="{Binding WebEditing}" IsEnabled="{Binding Available}" />
                    <CheckBox Margin="0,0,0,6" Content="Live autofocus points for the web UI (reads the Hocus Focus autofocus window, NINA 3.1.2.9001 with Hocus Focus 3.0.0.21 only)" IsChecked="{Binding LiveAutofocus}" IsEnabled="{Binding Available}" />
                </StackPanel>
            </Expander>

            <Expander
                Margin="0,10,0,10"
                ExpandDirection="Down"
                IsExpanded="{Binding DatabaseManagerIsExpanded}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Text="Target Management"
                            ToolTip="Manage your projects, targets, and exposure plans" />
                        <dm:DocumentationLink Margin="5,2,0,0" URL="target-management/index.html" />
                    </StackPanel>
                </Expander.Header>
                <dm:DatabaseManagerView DataContext="{Binding DatabaseManagerVM}" />
            </Expander>

            <Expander
                Margin="0,0,0,10"
                ExpandDirection="Down"
                IsExpanded="{Binding PlanPreviewIsExpanded}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Text="Scheduler Preview"
                            ToolTip="Preview and troubleshoot plans" />
                        <dm:DocumentationLink Margin="5,2,0,0" URL="scheduler-preview.html" />
                    </StackPanel>
                </Expander.Header>
                <pp:PlanPreviewerView DataContext="{Binding PlanPreviewerViewVM}" />
            </Expander>

            <Expander
                Margin="0,0,0,10"
                ExpandDirection="Down"
                IsExpanded="{Binding ReportingManagerIsExpanded}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Text="Reporting"
                            ToolTip="See reports" />
                        <dm:DocumentationLink Margin="5,2,0,0" URL="post-acquisition/reporting.html" />
                    </StackPanel>
                </Expander.Header>
                <rp:ReportingManagerView DataContext="{Binding ReportingManagerViewVM}" />
            </Expander>

            <Expander
                Margin="0,0,0,20"
                ExpandDirection="Down"
                IsExpanded="{Binding AcquiredImagesManagerIsExpanded}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Bold"
                            Text="Acquired Images"
                            ToolTip="View details on acquired images" />
                        <dm:DocumentationLink Margin="5,2,0,0" URL="post-acquisition/acquisition-data.html" />
                    </StackPanel>
                </Expander.Header>
                <ai:AcquiredImagesManagerView DataContext="{Binding AcquiredImagesManagerViewVM}" />
            </Expander>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>