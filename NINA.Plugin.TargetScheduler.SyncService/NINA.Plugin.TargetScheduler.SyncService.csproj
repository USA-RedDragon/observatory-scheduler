<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Sync\Protos\schedulersync.proto" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="$(GrpcVersion)" />
		<PackageReference Include="Grpc.Core.Api" Version="$(GrpcVersion)" />
		<PackageReference Include="Grpc.Tools" Version="$(GrpcVersion)">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="GrpcDotNetNamedPipes" Version="$(GrpcPipesVersion)" />
		<PackageReference Include="NINA.Plugin" Version="$(NinaVersion)" />
		<PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NINA.Plugin.TargetScheduler.Shared\NINA.Plugin.TargetScheduler.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Sync\Protos\schedulersync.proto" />
	</ItemGroup>

</Project>
